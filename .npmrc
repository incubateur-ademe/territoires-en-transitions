# Private Bryntum registry. The token lives encrypted in the root .env
# (BRYNTUM_ACCESS_TOKEN) and is passed to pnpm as the
# `pnpm_config_//npm.bryntum.com/:_authToken` environment variable by
# `make install`, the compose `deps` service and the Dockerfiles (pnpm no
# longer expands ${ENV} placeholders in a project .npmrc).
@bryntum:registry=https://npm.bryntum.com
