SELECT public.fixture_reset();
UPDATE public.indicateur_valeur SET date_valeur='2024-01-01' WHERE id=24464;
\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair WHERE valeur_id=24464),0::bigint,'An already corrected date is not archived by this migration');
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SELECT is((SELECT date_valeur FROM public.indicateur_valeur WHERE id=24464),DATE '2024-01-01','Revert retains a correction made before deployment');
SELECT public.fixture_reset();
SET TIME ZONE 'Europe/Paris';
SELECT public.fixture_observations() AS before_timezone_cycle \gset
\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
SET TIME ZONE 'Pacific/Auckland';
\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SET TIME ZONE 'Europe/Paris';
SELECT is(public.fixture_observations(),:'before_timezone_cycle'::jsonb,'Archive comparisons and restoration are independent of connection timezone');
SET TIME ZONE 'UTC';
SELECT * FROM finish();
