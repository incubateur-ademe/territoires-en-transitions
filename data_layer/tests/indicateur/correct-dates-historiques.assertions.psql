-- Dedicated disposable database only; invoked by correct-dates-historiques.spec.sh.
-- Actual Sqitch scripts own their transactions. Never include in normal *.sql tests.
\set ON_ERROR_STOP on
\getenv fixture_deploy INDICATEUR_DATE_REPAIR_TEST_DEPLOY
CREATE EXTENSION IF NOT EXISTS pgtap;
CREATE SCHEMA private;
SELECT plan(55);
CREATE TABLE public.indicateur_definition (id integer PRIMARY KEY);
CREATE TABLE public.indicateur_valeur (
 id integer PRIMARY KEY, indicateur_id integer NOT NULL, collectivite_id integer NOT NULL,
 date_valeur date NOT NULL, metadonnee_id integer, resultat double precision,
 resultat_commentaire text, objectif double precision, objectif_commentaire text,
 estimation double precision, modified_at timestamptz NOT NULL, created_at timestamptz NOT NULL,
 modified_by uuid, created_by uuid, calcul_auto boolean, calcul_auto_identifiants_manquants text[]
);
CREATE UNIQUE INDEX local_identity ON public.indicateur_valeur(indicateur_id,collectivite_id,date_valeur) WHERE metadonnee_id IS NULL;
CREATE UNIQUE INDEX source_identity ON public.indicateur_valeur(indicateur_id,collectivite_id,date_valeur,metadonnee_id) WHERE metadonnee_id IS NOT NULL;
CREATE TABLE public.action_score_indicateur_valeur (id integer PRIMARY KEY, indicateur_valeur_id integer REFERENCES public.indicateur_valeur(id) ON DELETE CASCADE);
CREATE TABLE public.fixture_migration_outcome (scenario text PRIMARY KEY, sqlstate text NOT NULL);
CREATE TABLE public.approved_dates (id integer, indicateur_id integer, collectivite_id integer, old_date date, new_date date, old_modified_at timestamptz);
INSERT INTO public.approved_dates VALUES
    (24464, 135, 1466, DATE '0001-01-01 BC', DATE '2024-01-01', TIMESTAMPTZ '2023-09-08 14:20:15.021497+00'),
    (27353, 333, 3830, DATE '0001-01-01 BC', NULL, TIMESTAMPTZ '2024-12-16 10:57:34.65994+00'),
    (287811340, 45906, 5596, DATE '20225-01-01', NULL, TIMESTAMPTZ '2026-03-05 10:12:11.546324+00'),
    (11979621, 31816, 2181, DATE '202501-01-01', NULL::date, TIMESTAMPTZ '2025-08-05 10:00:27.486379+00'),
    (11979622, 31816, 2181, DATE '202502-01-01', NULL::date, TIMESTAMPTZ '2025-08-05 10:00:29.529076+00'),
    (11979623, 31816, 2181, DATE '202503-01-01', NULL::date, TIMESTAMPTZ '2025-08-05 10:00:31.201245+00'),
    (11979624, 31816, 2181, DATE '202504-01-01', DATE '2025-01-01', TIMESTAMPTZ '2025-08-05 10:00:34.413885+00'),
    (12374016, 32392, 2181, DATE '202511-01-01', NULL::date, TIMESTAMPTZ '2025-09-04 19:49:53.948972+00'),
    (12374017, 32392, 2181, DATE '202512-01-01', DATE '2025-01-01', TIMESTAMPTZ '2025-09-04 19:50:03.704695+00');
CREATE FUNCTION public.fixture_observations() RETURNS jsonb LANGUAGE sql STABLE AS $$
 SELECT coalesce(jsonb_agg(to_jsonb(v) ORDER BY id),'[]'::jsonb) FROM public.indicateur_valeur v
$$;
\i :fixture_deploy
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair),0::bigint,'Empty database archives no absent observations');
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'Empty revert removes its empty archive');
INSERT INTO public.indicateur_valeur
SELECT id,indicateur_id,collectivite_id,old_date,NULL,
 CASE id WHEN 11979621 THEN 5 WHEN 11979622 THEN 7 WHEN 11979623 THEN 2 WHEN 11979624 THEN 8 WHEN 12374016 THEN NULL WHEN 12374017 THEN NULL ELSE id%11 END,
 'synthetic result comment',
 CASE id WHEN 11979621 THEN 3 WHEN 11979622 THEN 5 WHEN 11979623 THEN 7 WHEN 11979624 THEN 9 WHEN 12374016 THEN 2 WHEN 12374017 THEN 3 ELSE id%13 END,
 'synthetic objective comment',2.5,
 old_modified_at,TIMESTAMPTZ '2020-01-01 12:00:00+00','00000000-0000-0000-0000-000000000001','00000000-0000-0000-0000-000000000002',false,ARRAY['synthetic.dependency']
FROM public.approved_dates;
INSERT INTO public.indicateur_valeur (id,indicateur_id,collectivite_id,date_valeur,metadonnee_id,resultat,modified_at,created_at,calcul_auto)
VALUES (42,999,999,'2020-01-01',NULL,42,'2020-01-01','2020-01-01',false),
       (43,333,3830,'2023-01-01',77,0.58,'2020-01-01','2020-01-01',false);
CREATE TABLE public.fixture_baseline AS SELECT public.fixture_observations() AS observations;
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" prepare-fixture
CREATE FUNCTION public.fixture_touch() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.modified_at=clock_timestamp(); RETURN NEW; END; $$;
CREATE FUNCTION public.fixture_actor() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.modified_by='00000000-0000-0000-0000-000000000003'; RETURN NEW; END; $$;
CREATE TRIGGER modified_at BEFORE INSERT OR UPDATE ON public.indicateur_valeur FOR EACH ROW EXECUTE FUNCTION public.fixture_touch();
CREATE TRIGGER modified_by BEFORE INSERT OR UPDATE ON public.indicateur_valeur FOR EACH ROW EXECUTE FUNCTION public.fixture_actor();
CREATE FUNCTION public.fixture_reset() RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 TRUNCATE public.action_score_indicateur_valeur,public.indicateur_valeur;
 DROP TABLE IF EXISTS private.indicateur_valeur_date_repair;
 ALTER TABLE public.indicateur_valeur DISABLE TRIGGER modified_at;
 ALTER TABLE public.indicateur_valeur DISABLE TRIGGER modified_by;
 INSERT INTO public.indicateur_valeur SELECT r.* FROM public.fixture_baseline b CROSS JOIN LATERAL jsonb_populate_recordset(NULL::public.indicateur_valeur,b.observations) r;
 ALTER TABLE public.indicateur_valeur ENABLE TRIGGER modified_at;
 ALTER TABLE public.indicateur_valeur ENABLE TRIGGER modified_by;
END; $$;

-- Every preflight failure must precede both updates and deletes.
INSERT INTO public.indicateur_valeur SELECT 55,135,1466,'2024-01-01',NULL,99,NULL,NULL,NULL,NULL,now(),now(),NULL,NULL,false,NULL;
SELECT public.fixture_observations() AS before_failure \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy collision
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='collision'),'23505','Destination collision blocks the whole repair');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Collision leaves all nine approved observations untouched');
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'Failed deployment leaves no partial archive');
SELECT public.fixture_reset();
UPDATE public.indicateur_valeur SET collectivite_id=999 WHERE id=27353;
SELECT public.fixture_observations() AS before_failure \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy wrong_identity
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='wrong_identity'),'23514','Reused ID or changed identity is refused');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Identity failure is atomic');
SELECT public.fixture_reset();
UPDATE public.indicateur_valeur SET resultat=123456 WHERE id=287811340;
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy changed_data
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='changed_data'),'23514','Data changed since approval cannot be deleted');
SELECT public.fixture_reset();
-- A timestamp alone is not proof that the approved payload is still present.
ALTER TABLE public.indicateur_valeur DISABLE TRIGGER modified_at;
ALTER TABLE public.indicateur_valeur DISABLE TRIGGER modified_by;
UPDATE public.indicateur_valeur SET resultat=123456 WHERE id=287811340;
SELECT is((SELECT modified_at FROM public.indicateur_valeur WHERE id=287811340),
          (SELECT old_modified_at FROM public.approved_dates WHERE id=287811340),
          'Regression changes only the result, keeping the approved timestamp');
SELECT public.fixture_observations() AS before_failure \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy changed_result_only
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='changed_result_only'),'23514','Changed result is refused even with unchanged modified_at');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Result-only rejection preserves every observation');
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'Result-only rejection archives nothing');
SELECT public.fixture_reset();
ALTER TABLE public.indicateur_valeur DISABLE TRIGGER modified_at;
ALTER TABLE public.indicateur_valeur DISABLE TRIGGER modified_by;
UPDATE public.indicateur_valeur SET objectif_commentaire='changed without timestamp' WHERE id=11979624;
SELECT public.fixture_observations() AS before_failure \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy changed_comment_only
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='changed_comment_only'),'23514','Full image check also protects comments on a retained observation');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Comment-only rejection preserves every observation');
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'Comment-only rejection archives nothing');
SELECT public.fixture_reset();

-- A role subject to RLS must fail instead of operating on a filtered view.
GRANT USAGE ON SCHEMA public TO authenticated;
GRANT USAGE, CREATE ON SCHEMA private TO authenticated;
GRANT ALL ON public.indicateur_valeur TO authenticated;
GRANT SELECT ON public.action_score_indicateur_valeur TO authenticated;
ALTER TABLE public.indicateur_valeur ENABLE ROW LEVEL SECURITY;
CREATE POLICY fixture_read ON public.indicateur_valeur FOR SELECT TO authenticated USING (true);
CREATE POLICY fixture_update ON public.indicateur_valeur FOR UPDATE TO authenticated USING (true);
SELECT public.fixture_observations() AS before_failure \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy filtered_rls authenticated
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='filtered_rls'),'42501','A migration role subject to RLS is refused');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'RLS rejection preserves every observation');
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'RLS rejection leaves no archive');
DROP POLICY fixture_update ON public.indicateur_valeur;
DROP POLICY fixture_read ON public.indicateur_valeur;
ALTER TABLE public.indicateur_valeur DISABLE ROW LEVEL SECURITY;
REVOKE ALL ON public.indicateur_valeur, public.action_score_indicateur_valeur FROM authenticated;
REVOKE CREATE ON SCHEMA private FROM authenticated;

-- Check the actual effects even when a trigger silently skips a mutation.
CREATE FUNCTION public.fixture_skip() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NULL; END; $$;
CREATE TRIGGER fixture_skip BEFORE DELETE ON public.indicateur_valeur FOR EACH ROW EXECUTE FUNCTION public.fixture_skip();
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy skipped_delete
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='skipped_delete'),'23514','A skipped deletion fails the postflight');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Skipped deletion rolls back earlier date updates');
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'Skipped deletion leaves no false deletion archive');
DROP TRIGGER fixture_skip ON public.indicateur_valeur;
CREATE TRIGGER fixture_skip BEFORE UPDATE ON public.indicateur_valeur FOR EACH ROW EXECUTE FUNCTION public.fixture_skip();
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy skipped_update
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='skipped_update'),'23514','A skipped date update also fails the postflight');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Skipped update rolls back later deletions');
DROP TRIGGER fixture_skip ON public.indicateur_valeur;

INSERT INTO public.action_score_indicateur_valeur VALUES (1,27353);
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy score_reference
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='score_reference'),'23503','Referenced observation cannot cascade-delete a score link');
SELECT is((SELECT count(*) FROM public.action_score_indicateur_valeur),1::bigint,'Score reference survives rejected deletion');
SELECT public.fixture_reset();

\i :fixture_deploy
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair),9::bigint,'All nine changed records are archived');
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair WHERE apres IS NULL),6::bigint,'Exactly six approved deletions are archived');
SELECT is((SELECT count(*) FROM public.indicateur_valeur v JOIN public.approved_dates m USING(id) WHERE v.date_valeur=m.new_date),3::bigint,'Exactly three approved date mappings are applied');
SELECT is((SELECT count(*) FROM public.indicateur_valeur WHERE id IN (27353,287811340,11979621,11979622,11979623,12374016)),0::bigint,'Only the six designated local observations are removed');
SELECT ok(NOT EXISTS(SELECT 1 FROM private.indicateur_valeur_date_repair a JOIN public.indicateur_valeur v ON v.id=a.valeur_id WHERE (to_jsonb(v)-ARRAY['date_valeur','modified_at','modified_by']) IS DISTINCT FROM (a.avant-ARRAY['date_valeur','modified_at','modified_by'])),'Results, objectives, comments, provenance and other fields are preserved');
SELECT is((SELECT jsonb_agg(to_jsonb(v) ORDER BY id) FROM public.indicateur_valeur v WHERE id IN (42,43)),(SELECT jsonb_agg(r ORDER BY (r->>'id')::integer) FROM public.fixture_baseline b CROSS JOIN LATERAL jsonb_array_elements(b.observations) r WHERE (r->>'id')::integer IN (42,43)),'Unrelated and imported source rows are unchanged');
SELECT is((SELECT date_valeur FROM public.indicateur_valeur WHERE id=24464),DATE '2024-01-01','Bouguenais is assigned to 2024');
SELECT is((SELECT array_agg(date_valeur::text ORDER BY date_valeur) FROM public.indicateur_valeur WHERE collectivite_id=2181),ARRAY['2025-01-01','2025-01-01'],'Margny retains one January 1 observation per indicator');
SELECT is((SELECT jsonb_build_array(id,resultat,objectif) FROM public.indicateur_valeur WHERE indicateur_id=31816 AND collectivite_id=2181),'[11979624,8,9]'::jsonb,'The approved latest result 8 and objective 9 are retained without aggregation');
SELECT is((SELECT jsonb_build_array(id,resultat,objectif) FROM public.indicateur_valeur WHERE indicateur_id=32392 AND collectivite_id=2181),'[12374017,null,3]'::jsonb,'The approved latest objective 3 is retained and missing result stays null');
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair WHERE (avant->>'collectivite_id')::integer=2181),6::bigint,'All six original Margny observations remain in the private archive');
SELECT ok(NOT has_table_privilege('anon','private.indicateur_valeur_date_repair','SELECT') AND NOT has_table_privilege('authenticated','private.indicateur_valeur_date_repair','SELECT') AND NOT has_table_privilege('service_role','private.indicateur_valeur_date_repair','SELECT'),'Archive is inaccessible to application roles');
SELECT public.fixture_observations() AS after_repair \gset
SELECT jsonb_agg(to_jsonb(a) ORDER BY valeur_id) AS archive_after FROM private.indicateur_valeur_date_repair a \gset
\i :fixture_deploy
SELECT is(public.fixture_observations(),:'after_repair'::jsonb,'Redeploy does not rewrite repaired records');
SELECT is((SELECT jsonb_agg(to_jsonb(a) ORDER BY valeur_id) FROM private.indicateur_valeur_date_repair a),:'archive_after'::jsonb,'Redeploy preserves the original archive');
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SELECT is(public.fixture_observations(),(SELECT observations FROM public.fixture_baseline),'Revert restores every original field, including deleted rows and modification metadata');
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'Successful revert removes its archive');
SELECT is((SELECT count(*) FROM pg_trigger WHERE tgrelid='public.indicateur_valeur'::regclass AND tgname IN ('modified_at','modified_by') AND tgenabled='O'),2::bigint,'Metadata triggers are re-enabled after restoration');
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SELECT is(public.fixture_observations(),(SELECT observations FROM public.fixture_baseline),'Revert with no archive is a no-op');

\i :fixture_deploy
UPDATE public.indicateur_valeur SET resultat=98765, resultat_commentaire='later comment' WHERE id=24464;
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
SELECT pass('Historical verification permits ordinary later edits');
SELECT public.fixture_observations() AS before_failure \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure revert later_edit
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='later_edit'),'23514','Revert refuses later changes');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Refused revert preserves subsequent edits');
SELECT public.fixture_reset();
\i :fixture_deploy
INSERT INTO public.indicateur_valeur SELECT 27353,999,999,'2022-01-01',NULL,1,NULL,NULL,NULL,NULL,now(),now(),NULL,NULL,false,NULL;
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure revert reused_deleted_id
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='reused_deleted_id'),'23514','Revert does not overwrite a reused deleted ID');
SELECT public.fixture_reset();
\i :fixture_deploy
INSERT INTO public.indicateur_valeur SELECT 88,135,1466,DATE '0001-01-01 BC',NULL,1,NULL,NULL,NULL,NULL,now(),now(),NULL,NULL,false,NULL;
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure revert old_date_collision
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='old_date_collision'),'23505','Revert refuses a newly occupied original date');
SELECT public.fixture_reset();
\i :fixture_deploy
ALTER TABLE public.indicateur_valeur ADD COLUMN newer_contract text;
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
SELECT pass('Historical verification survives a later schema extension');
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure revert newer_schema
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='newer_schema'),'23514','Later schema migration must be reverted first');
ALTER TABLE public.indicateur_valeur DROP COLUMN newer_contract;
SELECT public.fixture_reset();
DELETE FROM public.indicateur_valeur WHERE id=24464;
\i :fixture_deploy
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair),8::bigint,'A record already absent is not invented or archived');
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SELECT is((SELECT count(*) FROM public.indicateur_valeur WHERE id=24464),0::bigint,'Revert does not resurrect an observation absent before deployment');
SELECT public.fixture_reset();
UPDATE public.indicateur_valeur SET date_valeur='2024-01-01' WHERE id=24464;
\i :fixture_deploy
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair WHERE valeur_id=24464),0::bigint,'An already corrected date is not archived by this migration');
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SELECT is((SELECT date_valeur FROM public.indicateur_valeur WHERE id=24464),DATE '2024-01-01','Revert retains a correction made before deployment');
SELECT public.fixture_reset();
SET TIME ZONE 'Europe/Paris';
SELECT public.fixture_observations() AS before_timezone_cycle \gset
\i :fixture_deploy
SET TIME ZONE 'Pacific/Auckland';
\i :fixture_deploy
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SET TIME ZONE 'Europe/Paris';
SELECT is(public.fixture_observations(),:'before_timezone_cycle'::jsonb,'Archive comparisons and restoration are independent of connection timezone');
SET TIME ZONE 'UTC';
SELECT * FROM finish();
