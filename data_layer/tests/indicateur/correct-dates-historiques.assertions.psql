    (11979621, 31816, 2181, DATE '202501-01-01', DATE '2025-01-01', TIMESTAMPTZ '2025-08-05 10:00:27.486379+00'),
    (11979622, 31816, 2181, DATE '202502-01-01', DATE '2025-02-01', TIMESTAMPTZ '2025-08-05 10:00:29.529076+00'),
    (11979623, 31816, 2181, DATE '202503-01-01', DATE '2025-03-01', TIMESTAMPTZ '2025-08-05 10:00:31.201245+00'),
    (11979624, 31816, 2181, DATE '202504-01-01', DATE '2025-04-01', TIMESTAMPTZ '2025-08-05 10:00:34.413885+00'),
    (12374016, 32392, 2181, DATE '202511-01-01', DATE '2025-11-01', TIMESTAMPTZ '2025-09-04 19:49:53.948972+00'),
    (12374017, 32392, 2181, DATE '202512-01-01', DATE '2025-12-01', TIMESTAMPTZ '2025-09-04 19:50:03.704695+00');
CREATE FUNCTION public.fixture_observations() RETURNS jsonb LANGUAGE sql STABLE AS $$
 SELECT coalesce(jsonb_agg(to_jsonb(v) ORDER BY id),'[]'::jsonb) FROM public.indicateur_valeur v
$$;
\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair),0::bigint,'Empty database archives no absent observations');
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'Empty revert removes its empty archive');
INSERT INTO public.indicateur_valeur
SELECT id,indicateur_id,collectivite_id,old_date,NULL,id%11,'synthetic result comment',id%13,'synthetic objective comment',2.5,
 old_modified_at,TIMESTAMPTZ '2020-01-01 12:00:00+00','00000000-0000-0000-0000-000000000001','00000000-0000-0000-0000-000000000002',false,ARRAY['synthetic.dependency']
FROM public.approved_dates;
INSERT INTO public.indicateur_valeur (id,indicateur_id,collectivite_id,date_valeur,metadonnee_id,resultat,modified_at,created_at,calcul_auto)
VALUES (42,999,999,'2020-01-01',NULL,42,'2020-01-01','2020-01-01',false),
       (43,333,3830,'2023-01-01',77,0.58,'2020-01-01','2020-01-01',false);
CREATE TABLE public.fixture_baseline AS SELECT public.fixture_observations() AS observations;
CREATE FUNCTION public.fixture_touch() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.modified_at=clock_timestamp(); RETURN NEW; END; $$;
CREATE FUNCTION public.fixture_actor() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.modified_by='00000000-0000-0000-0000-000000000003'; RETURN NEW; END; $$;
CREATE TRIGGER modified_at BEFORE INSERT OR UPDATE ON public.indicateur_valeur FOR EACH ROW EXECUTE FUNCTION public.fixture_touch();
CREATE TRIGGER modified_by BEFORE INSERT OR UPDATE ON public.indicateur_valeur FOR EACH ROW EXECUTE FUNCTION public.fixture_actor();
CREATE FUNCTION public.fixture_reset() RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 TRUNCATE public.action_score_indicateur_valeur,public.indicateur_valeur;
 DROP TABLE IF EXISTS private.indicateur_valeur_date_repair;
 ALTER TABLE public.indicateur_valeur DISABLE TRIGGER modified_at;
 ALTER TABLE public.indicateur_valeur DISABLE TRIGGER modified_by;
 INSERT INTO public.indicateur_valeur SELECT r.* FROM public.fixture_baseline b CROSS JOIN LATERAL jsonb_populate_recordset(NULL::public.indicateur_valeur,b.observations) r;
 ALTER TABLE public.indicateur_valeur ENABLE TRIGGER modified_at;
 ALTER TABLE public.indicateur_valeur ENABLE TRIGGER modified_by;
END; $$;

-- Every preflight failure must precede both updates and deletes.
INSERT INTO public.indicateur_valeur SELECT 55,135,1466,'2024-01-01',NULL,99,NULL,NULL,NULL,NULL,now(),now(),NULL,NULL,false,NULL;
SELECT public.fixture_observations() AS before_failure \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy collision
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='collision'),'23505','Destination collision blocks the whole repair');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Collision leaves all nine approved observations untouched');
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'Failed deployment leaves no partial archive');
SELECT public.fixture_reset();
UPDATE public.indicateur_valeur SET collectivite_id=999 WHERE id=27353;
SELECT public.fixture_observations() AS before_failure \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy wrong_identity
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='wrong_identity'),'23514','Reused ID or changed identity is refused');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Identity failure is atomic');
SELECT public.fixture_reset();
UPDATE public.indicateur_valeur SET resultat=123456 WHERE id=287811340;
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy changed_data
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='changed_data'),'23514','Data changed since approval cannot be deleted');
SELECT public.fixture_reset();
INSERT INTO public.action_score_indicateur_valeur VALUES (1,27353);
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy score_reference
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='score_reference'),'23503','Referenced observation cannot cascade-delete a score link');
SELECT is((SELECT count(*) FROM public.action_score_indicateur_valeur),1::bigint,'Score reference survives rejected deletion');
SELECT public.fixture_reset();

\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair),9::bigint,'All nine changed records are archived');
SELECT is((SELECT count(*) FROM private.indicateur_valeur_date_repair WHERE apres IS NULL),2::bigint,'Exactly two approved deletions are archived');
SELECT is((SELECT count(*) FROM public.indicateur_valeur v JOIN public.approved_dates m USING(id) WHERE v.date_valeur=m.new_date),7::bigint,'Exactly seven approved date mappings are applied');
SELECT is((SELECT count(*) FROM public.indicateur_valeur WHERE id IN (27353,287811340)),0::bigint,'Only the two designated local observations are removed');
SELECT ok(NOT EXISTS(SELECT 1 FROM private.indicateur_valeur_date_repair a JOIN public.indicateur_valeur v ON v.id=a.valeur_id WHERE (to_jsonb(v)-ARRAY['date_valeur','modified_at','modified_by']) IS DISTINCT FROM (a.avant-ARRAY['date_valeur','modified_at','modified_by'])),'Results, objectives, comments, provenance and other fields are preserved');
SELECT is((SELECT jsonb_agg(to_jsonb(v) ORDER BY id) FROM public.indicateur_valeur v WHERE id IN (42,43)),(SELECT jsonb_agg(r ORDER BY (r->>'id')::integer) FROM public.fixture_baseline b CROSS JOIN LATERAL jsonb_array_elements(b.observations) r WHERE (r->>'id')::integer IN (42,43)),'Unrelated and imported source rows are unchanged');
SELECT is((SELECT date_valeur FROM public.indicateur_valeur WHERE id=24464),DATE '2024-01-01','Bouguenais is assigned to 2024');
SELECT is((SELECT array_agg(date_valeur::text ORDER BY date_valeur) FROM public.indicateur_valeur WHERE collectivite_id=2181),ARRAY['2025-01-01','2025-02-01','2025-03-01','2025-04-01','2025-11-01','2025-12-01'],'Margny retains six separate monthly dates');
SELECT ok(NOT has_table_privilege('anon','private.indicateur_valeur_date_repair','SELECT') AND NOT has_table_privilege('authenticated','private.indicateur_valeur_date_repair','SELECT') AND NOT has_table_privilege('service_role','private.indicateur_valeur_date_repair','SELECT'),'Archive is inaccessible to application roles');
SELECT public.fixture_observations() AS after_repair \gset
SELECT jsonb_agg(to_jsonb(a) ORDER BY valeur_id) AS archive_after FROM private.indicateur_valeur_date_repair a \gset
\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
SELECT is(public.fixture_observations(),:'after_repair'::jsonb,'Redeploy does not rewrite repaired records');
SELECT is((SELECT jsonb_agg(to_jsonb(a) ORDER BY valeur_id) FROM private.indicateur_valeur_date_repair a),:'archive_after'::jsonb,'Redeploy preserves the original archive');
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SELECT is(public.fixture_observations(),(SELECT observations FROM public.fixture_baseline),'Revert restores every original field, including deleted rows and modification metadata');
SELECT ok(to_regclass('private.indicateur_valeur_date_repair') IS NULL,'Successful revert removes its archive');
SELECT is((SELECT count(*) FROM pg_trigger WHERE tgrelid='public.indicateur_valeur'::regclass AND tgname IN ('modified_at','modified_by') AND tgenabled='O'),2::bigint,'Metadata triggers are re-enabled after restoration');
\ir ../../sqitch/revert/indicateur/correct-dates-historiques.sql
SELECT is(public.fixture_observations(),(SELECT observations FROM public.fixture_baseline),'Revert with no archive is a no-op');

\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
UPDATE public.indicateur_valeur SET resultat=98765, resultat_commentaire='later comment' WHERE id=24464;
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
SELECT pass('Historical verification permits ordinary later edits');
SELECT public.fixture_observations() AS before_failure \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure revert later_edit
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='later_edit'),'23514','Revert refuses later changes');
SELECT is(public.fixture_observations(),:'before_failure'::jsonb,'Refused revert preserves subsequent edits');
SELECT public.fixture_reset();
\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
INSERT INTO public.indicateur_valeur SELECT 27353,999,999,'2022-01-01',NULL,1,NULL,NULL,NULL,NULL,now(),now(),NULL,NULL,false,NULL;
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure revert reused_deleted_id
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='reused_deleted_id'),'23514','Revert does not overwrite a reused deleted ID');
SELECT public.fixture_reset();
\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
INSERT INTO public.indicateur_valeur SELECT 88,135,1466,DATE '0001-01-01 BC',NULL,1,NULL,NULL,NULL,NULL,now(),now(),NULL,NULL,false,NULL;
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure revert old_date_collision
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='old_date_collision'),'23505','Revert refuses a newly occupied original date');
SELECT public.fixture_reset();
\ir ../../sqitch/deploy/indicateur/correct-dates-historiques.sql
ALTER TABLE public.indicateur_valeur ADD COLUMN newer_contract text;
\ir ../../sqitch/verify/indicateur/correct-dates-historiques.sql
SELECT pass('Historical verification survives a later schema extension');
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure revert newer_schema
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='newer_schema'),'23514','Later schema migration must be reverted first');
