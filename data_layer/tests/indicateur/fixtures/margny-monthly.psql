-- Synthetic images of the six originals and the two values kept by #5220.
-- Integration lifecycle on an isolated database with the deployed schema.
\set ON_ERROR_STOP on
SET search_path = public, extensions;
CREATE EXTENSION IF NOT EXISTS pgtap;
SELECT plan(5);
BEGIN;
SET LOCAL TIME ZONE 'UTC';
SET LOCAL DateStyle = 'ISO, YMD';
SET LOCAL extra_float_digits = 3;
INSERT INTO public.collectivite (id, nom, type) VALUES (2181, 'Fixture Margny', 'commune') ON CONFLICT (id) DO NOTHING;
INSERT INTO public.indicateur_definition (id, collectivite_id, titre, unite)
VALUES (31816, 2181, 'Fixture test', 'nombre'), (32392, 2181, 'Fixture projets', 'nombre');
INSERT INTO public.indicateur_valeur
    (id, indicateur_id, collectivite_id, date_valeur, resultat, objectif, resultat_commentaire,
     objectif_commentaire, estimation, created_at, modified_at)
VALUES
    (11979624, 31816, 2181, '2025-01-01', 8, 9, 'Commentaire à conserver', 'Objectif à conserver', 0,
     '2025-08-05 10:00:00+00', '2026-09-28 14:00:00+00'),
    (12374017, 32392, 2181, '2025-01-01', NULL, 3, NULL, 'Second commentaire', NULL,
     '2025-09-04 19:00:00+00', '2026-09-28 14:00:00+00');

INSERT INTO private.indicateur_valeur_date_repair (valeur_id, avant, apres)
SELECT expected.id,
       (to_jsonb(current_value) - 'periodicite') || jsonb_build_object(
           'id', expected.id, 'date_valeur', make_date(202500 + expected.mois, 1, 1),
           'resultat', expected.resultat, 'objectif', expected.objectif,
           'modified_at', TIMESTAMPTZ '2025-08-05 10:00:00+00'),
       CASE WHEN expected.id = current_value.id THEN to_jsonb(current_value) - 'periodicite' END
FROM (VALUES
    (11979621, 31816, 1, 5::double precision, 3::double precision),
    (11979622, 31816, 2, 7, 5), (11979623, 31816, 3, 2, 7), (11979624, 31816, 4, 8, 9),
    (12374016, 32392, 11, NULL, 2), (12374017, 32392, 12, NULL, 3)
) expected(id, indicateur_id, mois, resultat, objectif)
JOIN public.indicateur_valeur current_value ON current_value.indicateur_id = expected.indicateur_id;
COMMIT;

CREATE TEMP TABLE margny_before_values AS
SELECT id, to_jsonb(v) AS image FROM public.indicateur_valeur v;
CREATE TEMP TABLE margny_before_definitions AS
SELECT id, to_jsonb(d) AS image FROM public.indicateur_definition d;

\ir ../../../sqitch/deploy/indicateur/margny_indicateurs_mensuels.sql
\ir ../../../sqitch/verify/indicateur/margny_indicateurs_mensuels.sql
SELECT is((SELECT count(*) FROM public.indicateur_valeur WHERE indicateur_id IN (31816, 32392)),
    6::bigint, 'La migration restaure les six observations');
SELECT results_eq(
    $$ SELECT v.id, to_jsonb(v) FROM public.indicateur_valeur v WHERE indicateur_id IN (31816, 32392) ORDER BY v.id $$,
    $$ SELECT a.valeur_id, a.avant || jsonb_build_object(
        'periodicite', 'mensuelle',
        'date_valeur', make_date(2025, extract(year FROM (a.avant->>'date_valeur')::date)::integer - 202500, 1))
       FROM private.indicateur_valeur_date_repair a WHERE valeur_id IN (11979621,11979622,11979623,11979624,12374016,12374017) ORDER BY a.valeur_id $$,
    'Dates, valeurs, identifiants, commentaires et provenance correspondent aux archives');

\ir ../../../sqitch/revert/indicateur/margny_indicateurs_mensuels.sql
SELECT results_eq(
    $$ SELECT id, to_jsonb(v) FROM public.indicateur_valeur v ORDER BY id $$,
    $$ SELECT id, image FROM margny_before_values ORDER BY id $$,
    'Le revert restaure exactement les deux observations annuelles');
SELECT results_eq(
    $$ SELECT id, to_jsonb(d) FROM public.indicateur_definition d ORDER BY id $$,
    $$ SELECT id, image FROM margny_before_definitions ORDER BY id $$,
    'Le revert conserve les définitions et leurs métadonnées');

\ir ../../../sqitch/deploy/indicateur/margny_indicateurs_mensuels.sql
SELECT is((SELECT count(*) FROM public.indicateur_valeur WHERE indicateur_id IN (31816, 32392)),
    6::bigint, 'Le redéploiement fonctionne sans une PR suivante');
SELECT * FROM finish();
