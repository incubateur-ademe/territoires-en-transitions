\set ON_ERROR_STOP on
CREATE EXTENSION IF NOT EXISTS pgtap;
SELECT plan(18);
CREATE TABLE indicateur_definition (id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, titre text, valeur_calcule text);
CREATE TABLE indicateur_valeur (id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    indicateur_id integer REFERENCES indicateur_definition ON DELETE CASCADE, collectivite_id integer,
    date_valeur date NOT NULL, metadonnee_id integer, resultat double precision, objectif double precision,
    resultat_commentaire text, calcul_auto boolean, modified_at timestamptz DEFAULT now());
CREATE UNIQUE INDEX unique_indicateur_valeur_utilisateur ON indicateur_valeur(indicateur_id,collectivite_id,date_valeur) WHERE metadonnee_id IS NULL;
CREATE UNIQUE INDEX unique_indicateur_valeur_importee ON indicateur_valeur(indicateur_id,collectivite_id,date_valeur,metadonnee_id) WHERE metadonnee_id IS NOT NULL;
GRANT SELECT, INSERT, UPDATE, DELETE ON indicateur_valeur TO authenticated, service_role;
INSERT INTO indicateur_definition(titre,valeur_calcule) VALUES ('Historique','val(cae_2.lpcaet)');
INSERT INTO indicateur_valeur(indicateur_id,collectivite_id,date_valeur,resultat,objectif,resultat_commentaire,calcul_auto)
VALUES (1,1,'2025-12-31',0,NULL,'manuel',false);
CREATE TABLE fixture_before AS SELECT to_jsonb(v) AS row FROM indicateur_valeur v;
CREATE TABLE fixture_acl AS SELECT relacl FROM pg_class WHERE oid='indicateur_valeur'::regclass;
\ir ../../sqitch/deploy/indicateur/periodicite_schema.sql
\ir ../../sqitch/verify/indicateur/periodicite_schema.sql
SELECT is((SELECT to_jsonb(v)-'periodicite' FROM indicateur_valeur v WHERE id=1),(SELECT row FROM fixture_before),'Every historical observation field is preserved');
SELECT is((SELECT valeur_calcule FROM indicateur_definition WHERE id=1),'val(cae_2.lpcaet)','Formula is unchanged until the protected backend');
SELECT is((SELECT relacl::text FROM pg_class WHERE oid='indicateur_valeur'::regclass),(SELECT relacl::text FROM fixture_acl),'Historical table grants are unchanged');
SELECT is((SELECT periodicite FROM indicateur_valeur WHERE id=1),'annuelle','Existing observations are classified as annual');
SELECT lives_ok($q$ INSERT INTO indicateur_valeur(indicateur_id,collectivite_id,date_valeur,resultat)
 VALUES(1,1,'2025-12-31',3) ON CONFLICT(indicateur_id,collectivite_id,date_valeur) WHERE metadonnee_id IS NULL DO UPDATE SET resultat=excluded.resultat $q$,'Old local upsert still updates the exact historical date');
SELECT is((SELECT count(*) FROM indicateur_valeur),1::bigint,'Local upsert preserves identity without duplicate');
SELECT is((SELECT resultat FROM indicateur_valeur WHERE id=1),3::double precision,'Local result is updated');
SELECT lives_ok($q$ INSERT INTO indicateur_valeur(indicateur_id,collectivite_id,date_valeur,metadonnee_id,resultat)
 VALUES(1,1,'2025-12-31',7,4),(1,1,'2025-12-31',8,5) ON CONFLICT(indicateur_id,collectivite_id,date_valeur,metadonnee_id) WHERE metadonnee_id IS NOT NULL DO UPDATE SET resultat=excluded.resultat $q$,'Old imported upsert retains distinct source versions');
SELECT lives_ok($q$ INSERT INTO indicateur_valeur(indicateur_id,collectivite_id,date_valeur,metadonnee_id,resultat)
 VALUES(1,1,'2025-12-31',7,0) ON CONFLICT(indicateur_id,collectivite_id,date_valeur,metadonnee_id) WHERE metadonnee_id IS NOT NULL DO UPDATE SET resultat=excluded.resultat $q$,'Old imported update retains zero');
SELECT is((SELECT count(*) FROM indicateur_valeur),3::bigint,'Two source versions and local observation coexist');
SELECT throws_ok($q$ INSERT INTO indicateur_definition(titre,periodicite) VALUES('Mensuel','mensuelle') $q$,'23514',NULL,'Preparation rejects new cadences');
SELECT throws_ok($q$ UPDATE indicateur_definition SET aggregation_resultat='somme' WHERE id=1 $q$,'23514',NULL,'Preparation keeps aggregation disabled');
SELECT throws_ok($q$ UPDATE indicateur_periodicite SET nombre_unites=1 WHERE code='annuelle' $q$,'23514',NULL,'Catalogue meaning is immutable');
SELECT lives_ok($q$ UPDATE indicateur_valeur SET objectif=0,resultat_commentaire=NULL WHERE id=1 $q$,'Old update preserves zero and null semantics');
SELECT lives_ok($q$ INSERT INTO indicateur_valeur(indicateur_id,collectivite_id,date_valeur,resultat) VALUES(1,1,'2026-06-30',2) $q$,'An old producer can still write a noncanonical date');
CREATE TABLE fixture_after AS SELECT id,to_jsonb(v)-'periodicite' AS row FROM indicateur_valeur v;
\ir ../../sqitch/revert/indicateur/periodicite_schema.sql
SELECT ok(to_regclass('indicateur_periodicite') IS NULL,'Revert removes only the added schema');
SELECT results_eq('SELECT id,to_jsonb(v) FROM indicateur_valeur v ORDER BY id','SELECT id,row FROM fixture_after ORDER BY id','Revert preserves all writes made during the intermediate release');
SELECT lives_ok($q$ DELETE FROM indicateur_definition WHERE id=1 $q$,'Old cascade deletion still works after revert');
SELECT * FROM finish();
