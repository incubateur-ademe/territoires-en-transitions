-- Invoked ONLY by correct-formule-cae-2-a.spec.sh in its empty disposable DB.
-- Deliberately not *.sql: normal tests/**/*.sql must not run this fixture suite.
-- No outer BEGIN: actual deploy/revert COMMIT and verify ROLLBACK must execute.
\set ON_ERROR_STOP on
CREATE EXTENSION IF NOT EXISTS pgtap;
SELECT plan(27);

CREATE TABLE public.indicateur_definition (
  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  identifiant_referentiel text UNIQUE,
  collectivite_id integer,
  titre text NOT NULL,
  valeur_calcule text,
  modified_at timestamptz NOT NULL DEFAULT '2026-01-01 00:00:00+00',
  modified_by uuid
);
CREATE TABLE public.indicateur_valeur (
  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  indicateur_id integer NOT NULL REFERENCES public.indicateur_definition(id),
  collectivite_id integer NOT NULL,
  date_valeur date NOT NULL,
  metadonnee_id integer,
  resultat double precision,
  objectif double precision,
  resultat_commentaire text,
  objectif_commentaire text,
  calcul_auto boolean NOT NULL DEFAULT false,
  modified_at timestamptz NOT NULL DEFAULT '2026-01-01 00:00:00+00',
  modified_by uuid
);
CREATE TABLE public.fixture_migration_outcome (scenario text PRIMARY KEY, sqlstate text NOT NULL);
CREATE FUNCTION public.fixture_definitions() RETURNS jsonb LANGUAGE sql STABLE AS $$
  SELECT COALESCE(jsonb_agg(to_jsonb(d) ORDER BY id), '[]'::jsonb) FROM public.indicateur_definition d
$$;
CREATE FUNCTION public.fixture_observations() RETURNS jsonb LANGUAGE sql STABLE AS $$
  SELECT COALESCE(jsonb_agg(to_jsonb(v) ORDER BY id), '[]'::jsonb) FROM public.indicateur_valeur v
$$;
-- Detect unnecessary UPDATEs on redeployment, even if the formula stays equal.
CREATE FUNCTION public.mark_fixture_definition_modified() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  NEW.modified_at := OLD.modified_at + INTERVAL '1 second';
  RETURN NEW;
END;
$$;
CREATE TRIGGER modified_at BEFORE UPDATE ON public.indicateur_definition
FOR EACH ROW EXECUTE FUNCTION public.mark_fixture_definition_modified();

-- Keep RLS enabled for both the filtered-role failures and owner no-op cases.
GRANT USAGE ON SCHEMA public TO authenticated;
GRANT SELECT, UPDATE ON public.indicateur_definition TO authenticated;
ALTER TABLE public.indicateur_definition ENABLE ROW LEVEL SECURITY;
CREATE POLICY fixture_read ON public.indicateur_definition FOR SELECT TO authenticated USING (false);
CREATE POLICY fixture_update ON public.indicateur_definition FOR UPDATE TO authenticated USING (true);

-- Catalogue is empty when a new installation first applies this change.
\ir ../../sqitch/deploy/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/revert/indicateur/correct-formule-cae-2-a.sql
SELECT is(public.fixture_definitions(), '[]'::jsonb, 'An empty catalogue stays empty');

INSERT INTO public.indicateur_definition (identifiant_referentiel, titre, valeur_calcule) VALUES
('cae_2.l_pcaet', 'Synthetic source', NULL),
('cae_2.a', 'Synthetic target', E'  val(cae_2.e) +\n opt_val( cae_2.lpcaet ) + opt_val(cae_2.lpcaet_extra)  '),
('test.other', 'Unrelated definition', 'opt_val(cae_2.lpcaet)');
INSERT INTO public.indicateur_valeur
(indicateur_id, collectivite_id, date_valeur, metadonnee_id, resultat, objectif, resultat_commentaire, objectif_commentaire, calcul_auto)
SELECT id, 42, DATE '2025-01-01', metadata_id, 99, 123, 'manual result comment', 'manual objective comment', false
FROM public.indicateur_definition CROSS JOIN (VALUES (NULL::integer), (17)) AS versions(metadata_id)
WHERE identifiant_referentiel='cae_2.a';
INSERT INTO public.indicateur_valeur
(indicateur_id, collectivite_id, date_valeur, resultat, objectif, calcul_auto)
SELECT id, 42, DATE '2024-01-01', 0, NULL, true
FROM public.indicateur_definition WHERE identifiant_referentiel='cae_2.a';
SELECT public.fixture_observations() AS observations_before \gset
SELECT to_jsonb(d) AS unrelated_before FROM public.indicateur_definition d WHERE identifiant_referentiel='test.other' \gset
-- A hidden target must not be mistaken for a legitimately missing catalogue.
SELECT public.fixture_definitions() AS before_rls_failure \gset
SET ROLE authenticated;
SELECT count(*) AS visible_target_rows FROM public.indicateur_definition WHERE identifiant_referentiel='cae_2.a' \gset
RESET ROLE;
SELECT is(:'visible_target_rows'::bigint, 0::bigint, 'RLS hides the existing target despite table privileges');
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy filtered_rls_deploy authenticated
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='filtered_rls_deploy'), '42501', 'Deploy rejects a migration role subject to RLS');
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure verify filtered_rls_verify authenticated
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='filtered_rls_verify'), '42501', 'Verify rejects a migration role subject to RLS');
SELECT is(public.fixture_definitions(), :'before_rls_failure'::jsonb, 'RLS failures preserve every formula and its modification metadata');
SELECT is(public.fixture_observations(), :'observations_before'::jsonb, 'RLS failures preserve every stored observation');

\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure verify before_repair
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='before_repair'), '23514', 'Verify detects the broken predefined reference');
\ir ../../sqitch/deploy/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
SELECT is((SELECT valeur_calcule FROM public.indicateur_definition WHERE identifiant_referentiel='cae_2.a'),
  E'  val(cae_2.e) +\n opt_val( cae_2.l_pcaet ) + opt_val(cae_2.lpcaet_extra)  ',
  'Only the complete bad token changes; formatting and longer identifiers survive');
SELECT is(public.fixture_observations(), :'observations_before'::jsonb, 'Manual, metadata-backed and automatic observations are preserved');
SELECT is((SELECT to_jsonb(d) FROM public.indicateur_definition d WHERE identifiant_referentiel='test.other'), :'unrelated_before'::jsonb, 'Unrelated definitions and modification metadata are preserved');
SELECT public.fixture_definitions() AS after_repair \gset
\ir ../../sqitch/deploy/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
SELECT is(public.fixture_definitions(), :'after_repair'::jsonb, 'Redeploy is a true no-op, including UPDATE-trigger metadata');
\ir ../../sqitch/revert/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
SELECT is(public.fixture_definitions(), :'after_repair'::jsonb, 'Revert retains corrected catalogue data');
SELECT is(public.fixture_observations(), :'observations_before'::jsonb, 'Revert preserves every stored observation');

TRUNCATE public.indicateur_valeur, public.indicateur_definition RESTART IDENTITY;
INSERT INTO public.indicateur_definition (identifiant_referentiel,titre,valeur_calcule)
VALUES ('cae_2.a','Already corrected','opt_val(cae_2.l_pcaet)');
SELECT public.fixture_definitions() AS before_definitions \gset
\ir ../../sqitch/deploy/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
SELECT is(public.fixture_definitions(), :'before_definitions'::jsonb, 'An already corrected formula stays untouched, even without its source');

TRUNCATE public.indicateur_valeur, public.indicateur_definition RESTART IDENTITY;
INSERT INTO public.indicateur_definition (identifiant_referentiel,titre,valeur_calcule)
VALUES ('cae_2.a','Missing source','opt_val(cae_2.lpcaet)');
SELECT public.fixture_definitions() AS before_definitions \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy missing_source
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='missing_source'), '23503', 'A missing replacement source aborts repair');
SELECT is(public.fixture_definitions(), :'before_definitions'::jsonb, 'Missing-source failure preserves all definition fields');
INSERT INTO public.indicateur_definition (identifiant_referentiel,collectivite_id,titre)
VALUES ('cae_2.l_pcaet',42,'Custom source');
SELECT public.fixture_definitions() AS before_definitions \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy custom_source
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='custom_source'), '23503', 'A custom source cannot satisfy the predefined-source guard');
SELECT is(public.fixture_definitions(), :'before_definitions'::jsonb, 'Custom-source failure preserves all rows');

TRUNCATE public.indicateur_valeur, public.indicateur_definition RESTART IDENTITY;
INSERT INTO public.indicateur_definition (identifiant_referentiel,titre,valeur_calcule) VALUES
('cae_2.l_pcaet','Source',NULL), ('cae_2.a','Two defects','val(cae_2.lpcaet)+opt_val(cae_2.lpcaet)');
SELECT public.fixture_definitions() AS before_definitions \gset
\! bash "$INDICATEUR_DATA_REPAIR_TEST_RUNNER" expected-failure deploy duplicate_tokens
SELECT is((SELECT sqlstate FROM public.fixture_migration_outcome WHERE scenario='duplicate_tokens'), '23514', 'Two complete bad tokens are rejected');
SELECT is(public.fixture_definitions(), :'before_definitions'::jsonb, 'Duplicate-token failure retains the original formula and metadata');

TRUNCATE public.indicateur_valeur, public.indicateur_definition RESTART IDENTITY;
INSERT INTO public.indicateur_definition (identifiant_referentiel,titre,valeur_calcule)
VALUES ('cae_2.a','Different identifiers','val(cae_2.lpcaet_extra)+val(prefix_cae_2.lpcaet)+val(cae_2.lpcaet.sub)+val(cae_2.lpcaet-extended)');
SELECT public.fixture_definitions() AS before_definitions \gset
\ir ../../sqitch/deploy/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
SELECT is(public.fixture_definitions(), :'before_definitions'::jsonb, 'Prefix, suffix, dot and hyphen extensions remain intact');

TRUNCATE public.indicateur_valeur, public.indicateur_definition RESTART IDENTITY;
INSERT INTO public.indicateur_definition (identifiant_referentiel,collectivite_id,titre,valeur_calcule)
VALUES ('cae_2.a',42,'Custom target','opt_val(cae_2.lpcaet)');
SELECT public.fixture_definitions() AS before_definitions \gset
\ir ../../sqitch/deploy/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
SELECT is(public.fixture_definitions(), :'before_definitions'::jsonb, 'A custom target stays outside this predefined-catalogue repair');

TRUNCATE public.indicateur_valeur, public.indicateur_definition RESTART IDENTITY;
INSERT INTO public.indicateur_definition (identifiant_referentiel,titre)
VALUES ('cae_2.l_pcaet','Source without target');
SELECT public.fixture_definitions() AS before_definitions \gset
\ir ../../sqitch/deploy/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
SELECT is(public.fixture_definitions(), :'before_definitions'::jsonb, 'A missing target leaves existing definitions unchanged');

-- Null/blank formulas are not this defect; they must not require a source.
TRUNCATE public.indicateur_valeur, public.indicateur_definition RESTART IDENTITY;
INSERT INTO public.indicateur_definition (identifiant_referentiel,titre,valeur_calcule)
VALUES ('cae_2.a','Null formula',NULL);
SELECT public.fixture_definitions() AS before_definitions \gset
\ir ../../sqitch/deploy/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
SELECT is(public.fixture_definitions(), :'before_definitions'::jsonb, 'A null formula stays untouched');
UPDATE public.indicateur_definition SET valeur_calcule='   ';
SELECT public.fixture_definitions() AS before_definitions \gset
\ir ../../sqitch/deploy/indicateur/correct-formule-cae-2-a.sql
\ir ../../sqitch/verify/indicateur/correct-formule-cae-2-a.sql
SELECT is(public.fixture_definitions(), :'before_definitions'::jsonb, 'A blank formula stays untouched');
SELECT is((SELECT count(*) FROM public.fixture_migration_outcome), 6::bigint, 'Every expected failure executed the actual migration in a separate connection');
SELECT is((SELECT count(*) FROM public.indicateur_valeur), 0::bigint, 'Catalogue-only migrations never create observations');
SELECT * FROM finish();
