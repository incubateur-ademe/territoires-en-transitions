CREATE FUNCTION pg_temp.save_fiche_history() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO historique.fiche_action (fiche_id, collectivite_id, titre) VALUES (NEW.id, NEW.collectivite_id, NEW.titre);
    RETURN NEW;
END;
$$;
CREATE TRIGGER save_history AFTER UPDATE ON public.fiche_action FOR EACH ROW EXECUTE FUNCTION pg_temp.save_fiche_history();
CREATE FUNCTION pg_temp.touch_panier() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    UPDATE public.panier SET latest_update = CURRENT_TIMESTAMP WHERE id = OLD.panier_id;
    RETURN OLD;
END;
$$;
CREATE TRIGGER touch_panier AFTER DELETE ON public.action_impact_panier
FOR EACH ROW EXECUTE FUNCTION pg_temp.touch_panier();

CREATE FUNCTION pg_temp.promote_new_droit() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    NEW.niveau_acces := 'admin';
    RETURN NEW;
END;
$$;
CREATE TRIGGER promote_new_droit BEFORE INSERT ON public.private_utilisateur_droit
FOR EACH ROW EXECUTE FUNCTION pg_temp.promote_new_droit();
SELECT throws_ok('SELECT pg_temp.delete_arrondissements_paris_marseille(true)', 'P0001',
    'Un accès créé ne correspond pas au droit lecture prévu', 'Un trigger ne peut pas augmenter les nouveaux droits');
DROP TRIGGER promote_new_droit ON public.private_utilisateur_droit;

CREATE FUNCTION pg_temp.add_reference_after_delete() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO historique.action_statut VALUES (OLD.id, 'fait');
    RETURN OLD;
END;
$$;
CREATE TRIGGER add_reference_after_delete AFTER DELETE ON public.collectivite
FOR EACH ROW EXECUTE FUNCTION pg_temp.add_reference_after_delete();
SELECT throws_ok('SELECT pg_temp.delete_arrondissements_paris_marseille(true)', 'P0001',
    'Références restantes après traitement : historique.action_statut.collectivite_id',
    'Une référence sans FK créée par le dernier trigger annule le lot');
DROP TRIGGER add_reference_after_delete ON public.collectivite;

CREATE FUNCTION pg_temp.skip_delete() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    IF OLD.id = 36 THEN RETURN NULL; END IF;
    RETURN OLD;
END;
$$;
CREATE TRIGGER skip_delete BEFORE DELETE ON public.collectivite
FOR EACH ROW EXECUTE FUNCTION pg_temp.skip_delete();
SELECT throws_ok('SELECT pg_temp.delete_arrondissements_paris_marseille(true)', 'P0001',
    'Traitement incomplet de collectivite : 35/36 lignes', 'Une suppression incomplète annule la transaction');
SELECT is((SELECT count(*)::integer FROM public.collectivite_bucket), 46, 'Les liens sont restaurés après un échec');
SELECT results_eq('SELECT * FROM public.collectivite ORDER BY id', 'SELECT * FROM before_collectivites ORDER BY id', 'Tous les espaces sont restaurés après un échec');
SELECT results_eq('TABLE public.fiche_action', 'TABLE before_fiches', 'Un échec final annule aussi les transferts');
SELECT results_eq('TABLE public.private_utilisateur_droit', 'TABLE before_droits', 'Un échec final annule aussi les nouveaux droits');
SELECT is(to_regclass('private.arrondissements_paris_marseille_cleanup'), NULL::regclass, 'Un échec annule la création de l''archive');
DROP TRIGGER skip_delete ON public.collectivite;

SELECT is(pg_temp.delete_arrondissements_paris_marseille(true), 36, 'Les 36 espaces et leurs dépendances sont traités');
SELECT results_eq(
    'SELECT source_table, row_data FROM private.arrondissements_paris_marseille_cleanup WHERE operation = ''archive'' AND phase = ''before'' ORDER BY source_table, row_data',
    'SELECT source_table, row_data FROM expected_archive ORDER BY source_table, row_data',
    'Chaque ligne retirée, y compris les enfants, garde son image avant toute modification par trigger');
SELECT is((SELECT (row_data->>'latest_update')::timestamptz FROM private.arrondissements_paris_marseille_cleanup
    WHERE source_table = 'public.panier' AND phase = 'removed'), CURRENT_TIMESTAMP,
    'L''état modifié par le trigger est aussi conservé, séparément de l''original');
SELECT results_eq(
    'SELECT to_jsonb(f) - ''collectivite_id'' FROM public.fiche_action f ORDER BY id',
    'SELECT to_jsonb(f) - ''collectivite_id'' FROM before_fiches f ORDER BY id',
    'Les fiches et sous-actions gardent identifiants, contenu, auteurs et dates');
SELECT results_eq('SELECT id, collectivite_id FROM public.fiche_action ORDER BY id',
    'VALUES (1, 37), (2, 37), (3, 38), (4, 37)', 'Les fiches sont rattachées à leur Ville respective');
SELECT is((SELECT note FROM public.fiche_action_note WHERE fiche_id = 1), 'Note à conserver', 'Les liens des fiches sont préservés');
SELECT results_eq('TABLE public.indicateur_valeur', 'SELECT * FROM before_indicateurs WHERE collectivite_id > 36',
    'Les indicateurs Ville et Lyon restent intacts, sans agrégation ni réattribution');
SELECT results_eq('TABLE public.utilisateur', 'TABLE before_users', 'Tous les comptes restent intacts');
SELECT results_eq('SELECT user_id, collectivite_id, niveau_acces::text, active FROM public.private_utilisateur_droit ORDER BY user_id, collectivite_id',
    $$VALUES (1, 37, 'lecture', true), (2, 38, 'admin', true), (4, 38, 'lecture', true),
        (5, 37, 'lecture', true), (5, 38, 'lecture', true)$$,
    'Accès lecture seulement, un par Ville, sans réactivation des droits inactifs ni modification des accès existants');
SELECT results_eq('SELECT * FROM public.private_utilisateur_droit WHERE user_id = 2 AND collectivite_id = 38',
    'SELECT * FROM before_droits WHERE user_id = 2 AND collectivite_id = 38', 'Le droit Ville préexistant reste strictement identique');
SELECT is((SELECT count(*)::integer FROM historique.fiche_action WHERE collectivite_id IN (37, 38)), 3,
    'Les triggers de transfert restent actifs et écrivent sur la Ville');
SELECT is((SELECT count(*)::integer FROM private.arrondissements_paris_marseille_cleanup WHERE operation = 'transfer'), 3,
    'Les fiches transférées gardent une image de leur état initial');
SELECT is((SELECT count(*)::integer FROM private.arrondissements_paris_marseille_cleanup WHERE operation = 'grant'), 4,
    'Les nouveaux accès sont tracés dans le même lot');
SELECT ok(NOT has_table_privilege('arrondissements_test_reader', 'private.arrondissements_paris_marseille_cleanup', 'SELECT'),
    'L''archive ne donne pas accès aux données via PUBLIC');
SELECT ok(NOT (SELECT bool_or(has_table_privilege(role_name, 'private.arrondissements_paris_marseille_cleanup', 'SELECT'))
    FROM unnest(ARRAY['anon', 'authenticated', 'service_role']) role_name),
    'Les grants par défaut des API sont révoqués, même pour service_role avec BYPASSRLS');
SELECT is((SELECT count(*)::integer FROM public.collectivite WHERE id <= 36), 0, 'Aucun arrondissement ciblé ne reste');
SELECT results_eq('SELECT * FROM public.collectivite ORDER BY id',
    'SELECT * FROM before_collectivites WHERE id > 36 ORDER BY id', 'Villes, Lyon, codes voisins et autres types sont conservés');
SELECT results_eq('TABLE imports.commune', 'TABLE before_communes', 'Les données géographiques sont conservées');
SELECT results_eq('TABLE storage.buckets', 'TABLE before_buckets', 'Les buckets vides restent disponibles pour une gestion via Storage');
SELECT is((SELECT count(*)::integer FROM public.collectivite_bucket), 10, 'Seuls les liens des espaces ciblés sont supprimés');
SELECT is((SELECT count(*)::integer FROM public.fiche_action_import_csv), 3,
    'Les imports CSV hors périmètre restent intacts');
SELECT is(pg_temp.delete_arrondissements_paris_marseille(true), 0, 'Une nouvelle exécution est sans effet');

SELECT * FROM finish();
ROLLBACK;
