    'Plusieurs espaces portent le même code arrondissement : arbitrage requis', 'Un code dupliqué exige un arbitrage');
DELETE FROM public.collectivite WHERE nom = 'Doublon';
SELECT throws_ok('SELECT pg_temp.delete_arrondissements_paris_marseille(NULL)', 'P0001',
    'Le mode apply doit être true ou false', 'Un mode NULL est refusé');

CREATE ROLE arrondissements_test_reader;
GRANT USAGE ON SCHEMA public, storage, historique, imports TO arrondissements_test_reader;
SELECT format('GRANT USAGE ON SCHEMA %I TO arrondissements_test_reader', nspname)
FROM pg_namespace WHERE oid = pg_my_temp_schema() \gexec
GRANT SELECT ON ALL TABLES IN SCHEMA public, storage, historique, imports TO arrondissements_test_reader;
ALTER TABLE public.private_utilisateur_droit ENABLE ROW LEVEL SECURITY;
SET LOCAL ROLE arrondissements_test_reader;
SELECT throws_ok('SELECT pg_temp.delete_arrondissements_paris_marseille(false)', '42501', NULL,
    'Un rôle limité par RLS ne peut pas produire un inventaire incomplet');
SELECT throws_ok('SELECT pg_temp.delete_arrondissements_paris_marseille(true)', '42501', NULL,
    'Un rôle sans permission d''écriture ne peut pas supprimer');
RESET ROLE;

-- Frontière SQL réelle : cascades, triggers, enum des droits et lignes enfants.
-- Les anciens tests ne couvraient que le refus et les espaces vides.
CREATE SCHEMA labellisation;
CREATE SCHEMA migration;
CREATE SCHEMA archive;
CREATE SCHEMA private;
DO $$
DECLARE role_name text;
BEGIN
    FOREACH role_name IN ARRAY ARRAY['anon', 'authenticated', 'service_role'] LOOP
        IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = role_name) THEN
            EXECUTE format('CREATE ROLE %I %s', role_name,
                CASE WHEN role_name = 'service_role' THEN 'BYPASSRLS' ELSE '' END);
        END IF;
    END LOOP;
END;
$$;
GRANT USAGE ON SCHEMA private TO anon, authenticated, service_role;
ALTER DEFAULT PRIVILEGES IN SCHEMA private GRANT SELECT ON TABLES TO anon, authenticated, service_role;
CREATE TABLE public.fiche_action (
    id integer PRIMARY KEY,
    collectivite_id integer NOT NULL REFERENCES public.collectivite,
    parent_id integer REFERENCES public.fiche_action,
    titre text NOT NULL,
    description text,
    modified_by integer,
    modified_at timestamptz NOT NULL DEFAULT '2026-01-01',
    deleted boolean NOT NULL DEFAULT false
);
CREATE TABLE public.fiche_action_note (fiche_id integer REFERENCES public.fiche_action ON DELETE CASCADE, note text);
CREATE TABLE historique.fiche_action (id serial PRIMARY KEY, fiche_id integer, collectivite_id integer, titre text);
CREATE TABLE historique.fiche_action_pilote (
    fiche_historise_id integer REFERENCES historique.fiche_action ON DELETE CASCADE, user_id integer
);
CREATE TABLE public.indicateur_valeur (
    id integer PRIMARY KEY, collectivite_id integer REFERENCES public.collectivite ON DELETE CASCADE,
    indicateur_id integer, resultat numeric, objectif numeric, resultat_commentaire text, metadonnee_id integer
);
CREATE TABLE public.commune (code text, collectivite_id integer REFERENCES public.collectivite);
CREATE TABLE migration.plan_action (id integer PRIMARY KEY, collectivite_id integer);
CREATE TABLE labellisation.demande (id integer PRIMARY KEY, collectivite_id integer REFERENCES public.collectivite, envoyee_le timestamptz);
CREATE TABLE labellisation.audit (
    id integer PRIMARY KEY, collectivite_id integer REFERENCES public.collectivite,
    demande_id integer REFERENCES labellisation.demande, clos boolean
);
CREATE TABLE public.audit_auditeur (audit_id integer REFERENCES labellisation.audit, auditeur integer);
CREATE TABLE public.score_snapshot (id integer, collectivite_id integer, audit_id integer REFERENCES labellisation.audit, scores jsonb);
CREATE TABLE public.private_collectivite_membre (collectivite_id integer REFERENCES public.collectivite, user_id integer, fonction text);
CREATE TABLE public.panier (
    id integer PRIMARY KEY, collectivite_id integer REFERENCES public.collectivite,
    collectivite_preset integer REFERENCES public.collectivite,
    latest_update timestamptz NOT NULL DEFAULT '2026-01-01',
    private boolean GENERATED ALWAYS AS (collectivite_id IS NOT NULL) STORED
);
CREATE TABLE public.action_impact_panier (panier_id integer REFERENCES public.panier, action_id integer);
CREATE TABLE public.action_impact_statut (panier_id integer REFERENCES public.panier, action_id integer, categorie_id text);
CREATE TABLE public.action_pilote (collectivite_id integer, user_id integer, action_id text);
CREATE TABLE public.service_tag (id integer PRIMARY KEY, collectivite_id integer, nom text);
CREATE TABLE public.reponse_binaire (collectivite_id integer, question_id text, reponse boolean);
CREATE TABLE historique.reponse_binaire (collectivite_id integer, question_id text, reponse boolean);
CREATE TABLE archive.indicateur_resultat (collectivite_id integer, resultat numeric);
CREATE TABLE public.usage (collectivite_id integer, user_id integer, fonction text);
CREATE TABLE public.visite (collectivite_id integer, user_id integer);

