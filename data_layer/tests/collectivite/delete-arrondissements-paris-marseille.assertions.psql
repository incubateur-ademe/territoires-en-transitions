CREATE TEMP TABLE before_fiches AS SELECT * FROM public.fiche_action;
CREATE TEMP TABLE before_users AS SELECT * FROM public.utilisateur;
CREATE TEMP TABLE before_droits AS SELECT * FROM public.private_utilisateur_droit;
CREATE TEMP TABLE before_indicateurs AS SELECT * FROM public.indicateur_valeur;
CREATE TEMP TABLE expected_archive (source_table text, row_data jsonb);
-- Copie des données attendues, indépendante de la liste de traitement du script.
DO $$
DECLARE source text;
BEGIN
    FOREACH source IN ARRAY ARRAY[
        'public.commune', 'migration.plan_action', 'labellisation.demande', 'labellisation.audit',
        'public.score_snapshot', 'public.private_collectivite_membre', 'public.private_utilisateur_droit',
        'public.indicateur_valeur', 'public.action_pilote', 'public.service_tag', 'public.reponse_binaire',
        'historique.reponse_binaire', 'archive.indicateur_resultat', 'public.usage', 'public.visite',
        'historique.fiche_action', 'public.collectivite_bucket'
    ] LOOP
        EXECUTE format('INSERT INTO expected_archive SELECT $1, to_jsonb(t) FROM %s t WHERE collectivite_id <= 36', source) USING source;
    END LOOP;
END;
$$;
INSERT INTO expected_archive SELECT 'public.collectivite', to_jsonb(t) FROM public.collectivite t WHERE id <= 36;
INSERT INTO expected_archive SELECT 'historique.fiche_action_pilote', to_jsonb(t) FROM historique.fiche_action_pilote t;
INSERT INTO expected_archive SELECT 'public.audit_auditeur', to_jsonb(t) FROM public.audit_auditeur t WHERE audit_id = 1;
INSERT INTO expected_archive SELECT 'public.panier', to_jsonb(t) FROM public.panier t WHERE id = 1;
INSERT INTO expected_archive SELECT 'public.action_impact_panier', to_jsonb(t) FROM public.action_impact_panier t WHERE panier_id = 1;
INSERT INTO expected_archive SELECT 'public.action_impact_statut', to_jsonb(t) FROM public.action_impact_statut t WHERE panier_id = 1;

