# Secrets pour les tests locaux avec act
# (copier/renommer ce fichier en .act.secrets et ajouter les valeurs)

# Environnement supabase
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# nécessaire pour que le backend démarre et que le seed de la base se fasse correctement
GCLOUD_SERVICE_ACCOUNT_KEY=

# nécessaire pour que le backend démarre mais il n'est pas forcément nécessaire
# de mettre une valeur valide ici
BREVO_API_KEY=fake

# pour le site
STRAPI_KEY=
STRAPI_URL=http://127.0.0.1:1337

# clé pour l'installation du package @bryntum/scheduler
BRYNTUM_ACCESS_TOKEN=

# nécessaire seulement pour faire passer test-tools en local via act
SIRENE_API_KEY=

# Pour publier le Storybook sur Chromatic
CHROMATIC_PROJECT_TOKEN=
