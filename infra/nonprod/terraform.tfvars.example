# Copier en terraform.tfvars (gitignoré) et compléter.
# private_network_id se récupère après l'apply de infra/platform :
#   terraform -chdir=../platform output -raw main_project_id
#   terraform -chdir=../platform output -json private_network_ids | jq -r .nonprod

project_id = "00000000-0000-0000-0000-000000000000"
private_network_id  = "fr-par/00000000-0000-0000-0000-000000000000"

# Accès operateur
# IP de sortie de l'instance Coolify de l'incubateur (fournie par son admin),
# et IP de la passerelle VPN : terraform -chdir=../platform output -raw vpn_public_ip
ssh_allowed_ips = ["198.51.100.40/32", "203.0.113.21/32"]

server_ssh_authorized_keys = [
  "ssh-ed25519 AAAA... prenom.nom@example.org",
]

# Accès opérateur au Postgres preprod. Les conteneurs passent par le réseau
# privé : ne pas y ajouter l'IP du serveur applicatif.
pg_allowed_ips = {
  "203.0.113.10/32" = "poste opérateur"
}

# Destinataires des alertes Cockpit (observability.tf).
alert_emails = ["equipe@example.org"]
