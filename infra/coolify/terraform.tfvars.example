# Copier en terraform.tfvars (gitignoré) et compléter.
#
# Prérequis : les stacks platform, nonprod, prod et preview sont appliqués, et
# le token API Coolify existe dans Secret Manager.
#
#   source infra/scripts/tf-env.sh
#   source infra/scripts/coolify-env.sh
#
# Les valeurs ci-dessous se récupèrent avec :
#   terraform -chdir=../platform output -raw main_project_id
#   terraform -chdir=../platform output -raw coolify_public_ip
#   terraform -chdir=../nonprod  output -raw server_private_ip
#   terraform -chdir=../nonprod  output -raw server_ssh_key_secret_name
#   (idem pour preview)
#   terraform -chdir=../nonprod  output -raw server_sshd_host_public_key (idem prod, preview)
#   terraform -chdir=../prod     output -raw server_ssh_host
#   terraform -chdir=../platform output -raw prod_project_id

project_id = "00000000-0000-0000-0000-000000000000"
coolify_public_ip   = "203.0.113.20"

# terraform -chdir=../platform output -raw coolify_sshd_host_public_key
coolify_sshd_host_public_key = "ssh-ed25519 AAAA..."

app_servers = {
  nonprod = {
    name                = "tet-nonprod-apps"
    ssh_host            = "10.0.1.10"
    ssh_key_secret_name = "tet-nonprod-server-ssh-key"
    sshd_host_public_key = "ssh-ed25519 AAAA..."
  }
  prod = {
    name                = "tet-prod-apps"
    ssh_host            = "203.0.113.30" # IP publique : VPC séparé
    ssh_key_secret_name = "tet-prod-server-ssh-key"
    sshd_host_public_key = "ssh-ed25519 AAAA..."
    ssh_key_project_id  = "11111111-1111-1111-1111-111111111111"
  }
  preview = {
    name                = "tet-preview-apps"
    ssh_host            = "10.0.4.10"
    ssh_key_secret_name = "tet-preview-server-ssh-key"
    sshd_host_public_key = "ssh-ed25519 AAAA..."
  }
}

# Clés publiques age des opérateurs habilités à restaurer Coolify
# (age-keygen, cf. infra/README.md « Sauvegarde de l'instance Coolify »).
instance_backup_age_recipients = [
  "age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq",
]
