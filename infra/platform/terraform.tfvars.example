# Copier en terraform.tfvars (gitignoré) et compléter.

scaleway_project_id = "00000000-0000-0000-0000-000000000000"

# Opérateurs autorisés sur le bastion. Ce serveur donne accès SSH à TOUS les
# serveurs applicatifs : n'y lister que des IP fixes et connues.
coolify_ssh_allowed_ips = [
  "203.0.113.10/32",
]

coolify_ssh_authorized_keys = [
  "ssh-ed25519 AAAA... prenom.nom@example.org",
]

# Passer à true une fois territoiresentransitions.fr enregistré comme domaine
# externe chez Scaleway (cf. commentaire DNS dans main.tf).
dns_enabled = false
