# Copier en terraform.tfvars (gitignoré) et compléter.

# Projets créés par l'admin de l'organisation (cf. README « Prérequis admin »).
main_project_id             = "00000000-0000-0000-0000-000000000000"
prod_project_id             = "11111111-1111-1111-1111-111111111111"
coolify_backups_project_id  = "22222222-2222-2222-2222-222222222222"
database_backups_project_id = "33333333-3333-3333-3333-333333333333"

# Opérateurs autorisés sur le bastion. Ce serveur donne accès SSH à TOUS les
# serveurs applicatifs : n'y lister que des IP fixes et connues.
coolify_ssh_allowed_ips = [
  "203.0.113.10/32",
]

coolify_ssh_authorized_keys = [
  "ssh-ed25519 AAAA... prenom.nom@example.org",
]

# --- VPN des opérateurs (cf. README « Accès aux serveurs (VPN) ») ---

# Un pair par opérateur : sa clé publique (wg pubkey) et son adresse dans le
# tunnel (10.99.0.1 est la passerelle).
vpn_peers = {
  "prenom.nom" = { public_key = "AAAA...=", address = "10.99.0.2" }
}

# IP publiques des serveurs applicatifs, relayées par le tunnel :
#   terraform -chdir=../<tier> output -raw server_public_ip
vpn_routed_public_ips = ["203.0.113.30", "203.0.113.31", "203.0.113.32"]

vpn_ssh_authorized_keys = [
  "ssh-ed25519 AAAA... prenom.nom@example.org",
]
