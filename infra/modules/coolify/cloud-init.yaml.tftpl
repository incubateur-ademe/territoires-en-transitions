#cloud-config

users:
  - default
  - name: tet-ops
    groups:
      - sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
%{ for key in ssh_authorized_keys ~}
      - ${key}
%{ endfor ~}

package_update: true
package_upgrade: true

packages:
  - curl
  - fail2ban
  # openssh-server est requis par Coolify : il pilote chaque serveur (y compris
  # localhost) en SSH root. Déclaré explicitement pour ne pas dépendre de l'image.
  - openssh-server

write_files:
  # Config sshd dédiée Coolify (drop-in, survit aux upgrades du paquet openssh).
  # Le sshd_config Ubuntu inclut /etc/ssh/sshd_config.d/*.conf par défaut.
  # Voir https://coolify.io/docs/knowledge-base/server/openssh
  - path: /etc/ssh/sshd_config.d/50-coolify.conf
    permissions: "0644"
    content: |
      PubkeyAuthentication yes
      PermitRootLogin prohibit-password
      PasswordAuthentication no

runcmd:
  # Valider puis recharger sshd avec la config Coolify
  - sshd -t
  - systemctl restart ssh
  # Installer Docker (prérequis Coolify)
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker tet-ops
  # Installer Coolify
  - curl -fsSL https://cdn.coollabs.io/coolify/install.sh | bash
  # Autoriser la clé SSH générée par Coolify pour root@host.docker.internal.
  # Coolify (dans Docker) se connecte en SSH à l'hôte via host.docker.internal
  # en tant que root. Sa clé est générée par l'installeur dans /data/coolify/ssh/keys/.
  - mkdir -p /root/.ssh && chmod 700 /root/.ssh
  - touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys
  - cat /data/coolify/ssh/keys/id.root@host.docker.internal.pub >> /root/.ssh/authorized_keys

final_message: "TET Coolify bootstrap terminé en $UPTIME secondes. Accès dashboard : ssh -L 8000:localhost:8000 tet-ops@<ip-vm>"
