#cloud-config

# Control plane Coolify. Aucune application métier ne tourne ici : ce serveur
# n'héberge que Coolify lui-même, et sert de bastion SSH vers les serveurs
# applicatifs (dont le port 22 n'est pas exposé publiquement).

users:
  - default
  - name: tet-ops
    # Pas de groupe docker ici : il n'existe pas encore au moment de la création
    # de l'utilisateur (Docker est installé plus bas dans runcmd), et cloud-init
    # échouerait. L'ajout se fait via usermod en fin de boot.
    groups:
      - sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
%{ for key in ssh_authorized_keys ~}
      - ${key}
%{ endfor ~}

# Clé d'hôte sshd imposée par Terraform (cf. tls_private_key.sshd_host) : seule
# la clé ed25519 existe (genkeytypes ne génère que les types absents), et les
# clients la vérifient en mode strict.
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]
ssh_keys:
  ed25519_private: |
    ${indent(4, sshd_host_private_key)}
  ed25519_public: ${sshd_host_public_key}

package_update: true
package_upgrade: true

packages:
  - curl
  - jq
  - fail2ban
  # openssh-server est requis par Coolify : il pilote chaque serveur (y compris
  # localhost) en SSH root. Déclaré explicitement pour ne pas dépendre de l'image.
  - openssh-server

write_files:
  # Config sshd dédiée Coolify (drop-in, survit aux upgrades du paquet openssh).
  # Le sshd_config Ubuntu inclut /etc/ssh/sshd_config.d/*.conf par défaut.
  # Voir https://coolify.io/docs/knowledge-base/server/openssh
  - path: /etc/ssh/sshd_config.d/50-coolify.conf
    permissions: "0644"
    content: |
      PubkeyAuthentication yes
      PermitRootLogin prohibit-password
      PasswordAuthentication no
      # Seule clé d'hôte présente (cf. ssh_keys) : évite les avertissements
      # sur les clés rsa / ecdsa absentes.
      HostKey /etc/ssh/ssh_host_ed25519_key
      # Clés gérées par Terraform hors de ~/.ssh : Scaleway réécrit
      # /root/.ssh/authorized_keys au boot (clés SSH IAM du projet), et
      # install.sh y ajoute la sienne. Ce fichier-là, personne d'autre n'y
      # touche.
      AuthorizedKeysFile .ssh/authorized_keys /etc/ssh/authorized_keys.d/%u

  # Clé publique « host » maîtrisée par Terraform, autorisée sur root : c'est
  # elle que Coolify utilise pour piloter localhost (root@host.docker.internal).
  # Contrairement à la clé auto-générée par install.sh dans /data/coolify/ssh/keys/
  # (régénérée à chaque update/réinstall → connexion cassée), celle-ci est stable
  # et versionnée dans Scaleway Secret Manager.
  - path: /etc/ssh/authorized_keys.d/root
    owner: root:root
    permissions: "0644"
    content: |
      ${coolify_host_authorized_key}

runcmd:
  # Verrouiller les permissions de /root/.ssh (sinon sshd ignore authorized_keys)
  - chmod 700 /root/.ssh
  - chown root:root /root/.ssh
  # Valider puis recharger sshd avec la config Coolify
  - sshd -t
  - systemctl restart ssh
  # Installer Docker (prérequis Coolify)
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker tet-ops
  # Installer Coolify à une version stable figée (auto-update désactivé ensuite).
  # Monter de version sur une VM existante :
  #   curl -fsSL https://cdn.coollabs.io/coolify/install.sh | bash -s ${coolify_version}
  # puis réappliquer AUTOUPDATE=false (install.sh peut le réécrire).
  #
  # Pool d'adresses Docker hors 10.0.0.0/8 : le défaut d'install.sh (10.0.0.0/8
  # en /24) chevauche les Private Networks du VPC. docker0 prenait 10.0.1.0/24,
  # la route du PN nonprod perdait face à la route noyau du bridge, et Coolify
  # ne joignait plus le serveur nonprod (« No route to host »).
  - curl -fsSL https://cdn.coollabs.io/coolify/install.sh | DOCKER_ADDRESS_POOL_BASE=172.16.0.0/12 DOCKER_ADDRESS_POOL_SIZE=24 bash -s ${coolify_version}
  # Désactiver l'auto-update Coolify : on maîtrise quand on monte de version
  # (un update régénère les clés SSH et casse la connexion au serveur).
  # Prend effet au prochain cycle du scheduler qui relit le .env.
  - bash -c 'f=/data/coolify/source/.env; [ -f "$f" ] && { grep -q "^AUTOUPDATE=" "$f" && sed -i "s/^AUTOUPDATE=.*/AUTOUPDATE=false/" "$f" || echo "AUTOUPDATE=false" >> "$f"; }'
  # Aligner APP_URL sur le FQDN public : Coolify s'en sert pour les URL qu'il
  # génère (liens de mail, webhooks, callbacks OAuth).
  #
  # Ne suffit PAS à exposer le dashboard en HTTPS : le routage Traefik dépend du
  # réglage « Instance Domain », stocké en base et à poser une fois dans l'UI
  # (Settings > Configuration). Procédure dans infra/README.md.
  - bash -c 'f=/data/coolify/source/.env; [ -f "$f" ] && { grep -q "^APP_URL=" "$f" && sed -i "s#^APP_URL=.*#APP_URL=https://${coolify_fqdn}#" "$f" || echo "APP_URL=https://${coolify_fqdn}" >> "$f"; }'

final_message: "TET Coolify bootstrap terminé en $UPTIME secondes. Dashboard temporaire : ssh -L 8000:localhost:8000 tet-ops@<ip-vm> — puis configurer Settings > Instance Domain sur ${coolify_fqdn}."
