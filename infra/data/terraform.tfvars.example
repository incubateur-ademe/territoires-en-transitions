# Copier en terraform.tfvars (gitignoré) et compléter.
# private_network_id se récupère après l'apply de infra/platform :
#   terraform -chdir=../platform output -raw main_project_id
#   terraform -chdir=../platform output -json private_network_ids | jq -r .data

project_id         = "00000000-0000-0000-0000-000000000000"
private_network_id = "fr-par/00000000-0000-0000-0000-000000000000"

# Accès opérateur
server_ssh_authorized_keys = [
  "ssh-ed25519 AAAA... prenom.nom@example.org",
]

# Accès opérateur à la base de stats. Les conteneurs passent par le réseau
# privé : ne pas y ajouter l'IP du serveur data.
pg_allowed_ips = {
  "203.0.113.10/32" = "poste opérateur"
}
