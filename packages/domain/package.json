{
  "name": "@tet/domain",
  "description": "Domain library",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "nx": {
    "name": "domain",
    "tags": [
      "frontend"
    ],
    "sourceRoot": "packages/domain/src",
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/tsconfig.storybook.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          },
          "{workspaceRoot}/apps/**/*.{ts,tsx}",
          "{workspaceRoot}/packages/**/*.{ts,tsx}",
          "{workspaceRoot}/supabase/functions/**/*.{ts,tsx}"
        ]
      },
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/domain/dist",
          "main": "packages/domain/src/index.ts",
          "tsConfig": "packages/domain/tsconfig.lib.json",
          "stripLeadingPaths": true
        }
      }
    }
  }
}
