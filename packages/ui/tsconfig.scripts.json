{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/scripts",
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "jsdom"]
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.tsx", "scripts/**/*.mts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
