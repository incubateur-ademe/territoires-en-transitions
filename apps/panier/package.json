{
  "name": "@tet/panier",
  "version": "4.101.0",
  "nx": {
    "name": "panier",
    "tags": ["frontend"],
    "targets": {
      "dev": {
        "continuous": true,
        "dependsOn": ["^build"],
        "command": "next dev --webpack -p ${PANIER_PORT:-3002}",
        "options": {
          "cwd": "apps/panier"
        }
      },
      "build": {
        "options": {
          "command": "next build --webpack"
        }
      }
    },
    "// targets": "to see all targets run: nx show project panier --web"
  }
}
