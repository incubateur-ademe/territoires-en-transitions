{
  "extends": "./tsconfig.project.json",
  "compilerOptions": {
    "outDir": "out-tsc/spec",
    "types": [
      "node",
      "vitest/globals",
      "vitest/importMeta",
      "vite/client"
    ]
  },
  "include": [
    "*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/fixture.json"
  ],
  "exclude": [
    "out-tsc/**/*",
    "vitest.config.mts",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/*.stories.js",
    "**/*.stories.jsx"
  ]
}
