{
  "extends": "./tsconfig.project.json",
  "compilerOptions": {
    "outDir": "out-tsc/storybook",
    "paths": {
      "@/app/*": ["./src/*"]
    }
  },
  "include": [
    "*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.stories.js",
    "**/*.stories.jsx",
    ".next/types/**/*.ts",
    ".storybook/*.js",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "**/fixture.json"
  ],
  "exclude": [
    "out-tsc/**/*",
    "vitest.config.mts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.js",
    "**/*.test.js",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "**/*.spec.jsx",
    "**/*.test.jsx"
  ]
}
