{
  "name": "@/app",
  "nx": {
    "name": "app",
    "tags": [
      "frontend"
    ],
    "targets": {
      "dev": {
        "dependsOn": [
          "^build"
        ],
        "options": {
          "port": 3000
        }
      },
      "typecheck": {
        "dependsOn": ["^typecheck"],
        "command": "tsc --noEmit -p tsconfig.project.json",
        "options": {
          "cwd": "apps/app"
        },
        "cache": true
      }
    }
  }
}
