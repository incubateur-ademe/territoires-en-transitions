{
  "name": "@tet/site",
  "version": "4.101.0",
  "nx": {
    "name": "site",
    "targets": {
      "dev": {
        "continuous": true,
        "dependsOn": ["^build"],
        "command": "next dev --webpack -p ${SITE_PORT:-3001}",
        "options": {
          "cwd": "apps/site"
        }
      },
      "build": {
        "options": {
          "command": "next build --webpack"
        }
      }
    },
    "// targets": "to see all targets run: nx show project site --web"
  }
}
