{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/src",
  "projectType": "application",
  "tags": ["scope:backend"],
  "targets": {
    "dev": {
      "command": "nest start --watch",
      "// debug": "nest start --debug --watch",
      "options": {
        "cwd": "apps/backend"
      }
    },
    "seed-imports": {
      "command": "pnpm exec vitest run --project already-run-by-init-db-seed",
      "cache": false,
      "options": {
        "cwd": "apps/backend"
      }
    },
    "build-deps": {
      "executor": "nx:noop",
      "dependsOn": ["^build"]
    },
    "build": {
      "command": "nest build",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/backend"
      }
    }
  }
}
